#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Take the add-on down when the agent stops
# ==============================================================================
declare exit_code="${1}"

# 256 means s6 itself signalled the service; anything else is the agent exiting.
if [[ "${exit_code}" -ne 0 ]] && [[ "${exit_code}" -ne 256 ]]; then
    bashio::log.warning "The Arcane edge agent exited with code ${exit_code}; stopping the add-on."
fi

exec /sbin/halt
